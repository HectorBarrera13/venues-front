# API
VITE_API_BASE_URL = "http://quieroqueue:2000"

# Events service origin; canonical /api/v1/events is appended by the client.
# Leave empty in development to use the /events-api proxy to localhost:3000.
VITE_EVENTS_API_BASE_URL =

# Authentication is mocked through /login; see README.md for demo accounts.

# Original Venue development credential source. Supply a JWT from the Venue/Auth
# workflow; this frontend does not generate or sign a JWT.
VITE_DEV_TOKEN =

# VEN-005 contract mock. "true" serves the venue-service API from an in-browser
# MSW mock (src/mocks), so `npm run dev` works without any backend. Remove it (or
# set "false") to call the real service: same contract, same URLs.
VITE_USE_MOCK =
# With the mock, VITE_DEV_TOKEN can be this unsigned demo owner JWT (sub = the
# owner@example.com demo account). The mock reads its claims without verifying
# the signature; the real venue-service rejects it.
# VITE_DEV_TOKEN = eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJzdWIiOiIyMjIyMjIyMi0yMjIyLTIyMjItMjIyMi0yMjIyMjIyMjIyMjIiLCJyb2xlIjoiVkVOVUVfT1dORVIiLCJuYW1lIjoiUHJvcGlldGFyaW8gZGVtbyJ9.mock
